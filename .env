# --- Construction Industry Solutions — environment ---
# SQLite for zero-setup local dev. Swap to a PostgreSQL URL for production
# (the Prisma schema is written to be portable).
DATABASE_URL="file:./dev.db"

# JWT signing secret for auth. CHANGE THIS in production.
AUTH_SECRET="dev-only-change-me-super-secret-key-cis-2026-platform"

# Session lifetime (seconds) — 7 days
AUTH_TTL_SECONDS=604800

# Public app URL (used for deep links in alerts)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
